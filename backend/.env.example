# Option 1: Full Supabase PostgreSQL Connection String (Recommended)
# Replace [YOUR-PASSWORD] with your actual Supabase database password
# DATABASE_URL=postgresql+psycopg2://postgres:[YOUR-PASSWORD]@db.rsiyyalrgvsxkcrmgcry.supabase.co:5432/postgres?sslmode=require

# Option 2: Individual Supabase connection parameters
# user=postgres
# password=[YOUR-PASSWORD]
# host=db.rsiyyalrgvsxkcrmgcry.supabase.co
# port=5432
# dbname=postgres

# If left unset, the backend will automatically use the zero-setup SQLite fallback (kabadiwala.db).
DATABASE_URL=
SECRET_KEY=kabadiwala-connect-prototype-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
